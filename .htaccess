<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # כפיית HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # אל תבצע ניתוב מחדש אם הקובץ קיים פיזית (זה קריטי עבור backend_core.php)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # אל תבצע ניתוב מחדש עבור קבצי ה-API
  RewriteCond %{REQUEST_URI} ^/backend_core\.php [NC]
  RewriteRule ^ - [L]

  # הפנה את כל השאר ל-index.html (עבור React Router)
  RewriteRule ^ index.html [L]
</IfModule>