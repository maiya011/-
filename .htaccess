
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # כפיית HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # אל תבצע ניתוב מחדש אם הקובץ או התיקייה קיימים פיזית
  # זה מאפשר לקבצי assets (JS, CSS, תמונות) ולקובץ ה-PHP לעבוד
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # הפנה את כל הבקשות האחרות ל-index.html
  # זה מאפשר ל-React Router לנהל את הניווט (למשל /forum או /tips)
  RewriteRule ^ index.html [L]
</IfModule>

# אבטחה בסיסית - מניעת צפייה ברשימת קבצים בתיקיות
Options -Indexes

# הגדרת סוגי קבצים
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
</IfModule>
